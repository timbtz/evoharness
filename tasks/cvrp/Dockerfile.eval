# Scoring container for the cvrp task: python + gcc + numpy, nothing else.
# Built lazily by core.sandbox.docker_image_ready as image "evoharness-cvrp-eval".
FROM python:3.13-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir numpy
