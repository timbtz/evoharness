  "current_code_inspection": {
    "architecture": "JAX derivatives of downstream metrics contracted with central finite differences of solver outputs. This is a hybrid local derivative estimate, not a VMEC++ adjoint or end-to-end differentiation of the equilibrium solver.",
    "cost": "metric_grad reserves 2*k+1 evaluations upfront: 41 at k=20. The service actually solves 2*m+1 times for m eligible already-nonzero coefficients, where m <= k. Proposal verification adds a fresh solve.",
    "current_direction": "Honest-score mode differentiates L/20 minus the weighted worst-violation penalty when aspect or QI binds; its fallback jointly projects against supported active constraints. task.grad_step can additionally add a nearest-bank-distance subgradient. This is newer than the original sequential-projection polish trajectory.",
    "runtime_isolation": "The gradient service runs in a child process so the evaluation-pool parent does not initialize JAX/XLA before forking.",
    "concerns_not_numerically_validated_in_this_audit": [
      {
        "name": "Fixed minor-radius normalization",
        "evidence": "polish.py:90-101 differentiates six WOUT arrays while holding Aminor_p fixed; lgradb_jax.py:168 divides the metric by Aminor_p.",
        "implication": "The implemented L derivative omits the boundary response of this normalization. Do not label it a complete exact boundary derivative."
      },
      {
        "name": "Aspect scaling in feasibility repair",
        "evidence": "finite_difference.py:175-177 already divides aspect gradients by ASPECT_BOUND=10; polish.py:240 divides ga by 10 again.",
        "implication": "This appears to rescale aspect twice relative to the intended violation derivative. It requires a numerical check; it is not an established explanation for failed runs."
      }
    ],
    "documented_approximations_and_api_limits": [
      {
        "name": "Frozen magnetic axis",
        "evidence": "boundary_grad.py:98-118 and polish.py:126-143",
        "implication": "Elongation gradients hold the base equilibrium's axis fixed and omit its boundary response; treat them as advisory local directions."
      },
      {
        "name": "Mirror gradient is optional",
        "evidence": "boundary_grad.py:78-89 returns grad_mirror when requested; task.py:700-702 defaults to L, qi, aspect, elongation.",
        "implication": "The available mirror extension does not mean default metric_grad calls expose it, or that grad_step uses it in its composite objective."
      },
      {
        "name": "Trust and acceptance",
        "evidence": "polish.py:320-347 and task.py:724-752",
        "implication": "A step is a proposal requiring evaluation. Current incumbent-based acceptance fixes a regression visible in historical qi_polish step 8."
      }
    ]
  },
